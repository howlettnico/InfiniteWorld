// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel CSMain

struct BlockStateRenderData
{
    int texIndex;
    int animated;
    int numFrames;
    float fps;
};

struct BlockRenderData
{
    int stateI;
    int rotated;
};

// Create a RenderTexture with enableRandomWrite flag and set it
// with cs.SetTexture
RWTexture2D<float4> Result;
int textureWidth, textureHeight, worldWidth, worldHeight;
float Time;

StructuredBuffer<BlockRenderData> _BlockDataBuffer;
StructuredBuffer<BlockStateRenderData> _BlockStateDataBuffer;

Texture2DArray<float4> _BlockTexs;
SamplerState sampler_BlockTexs;

int GetIndex(int x, int y, bool ground)
{
    return y * worldWidth + x + (ground ? 0 : worldWidth * worldHeight);
}

//Written by Claud Sonnet 4.6
float4 AlphaBlend(float4 bottom, float4 top)
{
    float a = top.a + bottom.a * (1.0 - top.a);
    if (a <= 0.0) return float4(0, 0, 0, 0);
    float3 rgb = (top.rgb * top.a + bottom.rgb * bottom.a * (1.0 - top.a)) / a;
    return float4(rgb, a);
}

[numthreads(8,8,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    float2 uv = float2((float) id.x / textureWidth, (float) id.y / textureHeight);
    // Result[id.xy] = float4(uv.x, uv.y, 0, 1);
    // Result[id.xy] = float4(id.x & id.y, (id.x & 15)/15.0, (id.y & 15)/15.0, 1);

    const float2 block_uv = float2(uv.x * worldWidth, uv.y * worldHeight);

    const float2 tex_uv = fmod(block_uv, 1);

    const int2 array_uv = int2((int) block_uv.x, (int) block_uv.y);

    const int g_block_index = GetIndex(array_uv.x, array_uv.y, true);
    const int ag_block_index = GetIndex(array_uv.x, array_uv.y, false);

    const BlockRenderData g_block = _BlockDataBuffer[g_block_index];
    const BlockRenderData ag_block = _BlockDataBuffer[ag_block_index];

    const BlockStateRenderData g_state = _BlockStateDataBuffer[g_block.stateI];
    const BlockStateRenderData ag_state = _BlockStateDataBuffer[ag_block.stateI];

    // type.animated is 0 if there is no animation so it will destroy any value generated by the rest of it
    const float g_texIndex = g_state.texIndex + g_state.animated * fmod(floor(Time * g_state.fps), (float) g_state.numFrames);
    const float ag_texIndex = ag_state.texIndex + ag_state.animated * fmod(floor(Time * ag_state.fps), (float) ag_state.numFrames);

    const float2 g_adjusted_tex_uv = (g_block.rotated ^ 1) * tex_uv + g_block.rotated * float2(tex_uv.y, tex_uv.x);
    const float2 ag_adjusted_tex_uv = (ag_block.rotated ^ 1) * tex_uv + ag_block.rotated * float2(tex_uv.y, tex_uv.x);
    
    const float4 g_col = _BlockTexs.SampleLevel(sampler_BlockTexs, float3(g_adjusted_tex_uv.x, g_adjusted_tex_uv.y, g_texIndex), 0.0);
    const float4 ag_col = _BlockTexs.SampleLevel(sampler_BlockTexs, float3(ag_adjusted_tex_uv.x, ag_adjusted_tex_uv.y, ag_texIndex), 0.0);

    const float4 final_col = AlphaBlend(g_col, ag_col);
    Result[id.xy] = final_col;
}
